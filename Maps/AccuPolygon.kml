<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Egyptian Cities Environmental Assessment - Helwan, 10th of Ramadan, El-Mahalla El-Kubra</name>
    <description>
      Illustrative LST (Land Surface Temperature) and Carbon Footprint data for three major Egyptian industrial cities.
      Based on 2025-2026 geographic boundaries and environmental assessments.
    </description>

    <!-- Style Definitions (Choropleth colors) -->
    <Style id="level_low">
      <PolyStyle>
        <color>7d00ff00</color> <!-- Semi-transparent Green -->
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
      <LineStyle>
        <color>ff000000</color>
        <width>1.5</width>
      </LineStyle>
    </Style>

    <Style id="level_medium">
      <PolyStyle>
        <color>7d00ffff</color> <!-- Semi-transparent Yellow -->
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
      <LineStyle>
        <color>ff000000</color>
        <width>1.5</width>
      </LineStyle>
    </Style>

    <Style id="level_high">
      <PolyStyle>
        <color>7d00a5ff</color> <!-- Semi-transparent Orange -->
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
      <LineStyle>
        <color>ff000000</color>
        <width>1.5</width>
      </LineStyle>
    </Style>

    <Style id="level_critical">
      <PolyStyle>
        <color>7d0000ff</color> <!-- Semi-transparent Red -->
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
      <LineStyle>
        <color>ff000000</color>
        <width>1.5</width>
      </LineStyle>
    </Style>

    <!-- 1. Helwan (Heavy Industry, High Carbon Footprint, Severe UHI) -->
    <Placemark>
      <name>Helwan (حلوان)</name>
      <styleUrl>#level_critical</styleUrl>
      <ExtendedData>
        <Data name="Governorate">
          <value>Cairo (Southern Area)</value>
        </Data>
        <Data name="Estimated LST (Summer Avg)">
          <value>44.2 °C</value>
        </Data>
        <Data name="UHI Intensity (Delta T)">
          <value>+4.8 °C</value>
        </Data>
        <Data name="Carbon Footprint (kTon CO2e/yr)">
          <value>12,800</value>
        </Data>
        <Data name="Monte Carlo Confidence Interval">
          <value>95% [43.1, 45.3]</value>
        </Data>
        <Data name="Primary Industries">
          <value>Iron &amp; Steel, Cement, Textiles, Automotive</value>
        </Data>
        <Data name="Population">
          <value>521,239 (2017)</value>
        </Data>
        <Data name="Area">
          <value>65 km²</value>
        </Data>
      </ExtendedData>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              31.2500,29.9000,0
              31.4000,29.9000,0
              31.4000,29.6667,0
              31.2500,29.6667,0
              31.2500,29.9000,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- 2. 10th of Ramadan City (New Industrial Hub, Moderate UHI) -->
    <Placemark>
      <name>10th of Ramadan City (العاشر من رمضان)</name>
      <styleUrl>#level_medium</styleUrl>
      <ExtendedData>
        <Data name="Governorate">
          <value>Sharqia</value>
        </Data>
        <Data name="Estimated LST (Summer Avg)">
          <value>41.8 °C</value>
        </Data>
        <Data name="UHI Intensity (Delta T)">
          <value>+3.5 °C</value>
        </Data>
        <Data name="Carbon Footprint (kTon CO2e/yr)">
          <value>9,200</value>
        </Data>
        <Data name="Monte Carlo Confidence Interval">
          <value>95% [40.7, 42.9]</value>
        </Data>
        <Data name="Primary Industries">
          <value>Textiles, Manufacturing, Logistics</value>
        </Data>
        <Data name="Population">
          <value>246,148 (2021)</value>
        </Data>
        <Data name="Area">
          <value>66 km²</value>
        </Data>
      </ExtendedData>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              31.7100,30.2800,0
              31.7700,30.2800,0
              31.7700,30.3300,0
              31.7100,30.3300,0
              31.7100,30.2800,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- 3. El-Mahalla El-Kubra (Textile Hub, Industrial Agricultural) -->
    <Placemark>
      <name>El-Mahalla El-Kubra (المحلة الكبرى)</name>
      <styleUrl>#level_high</styleUrl>
      <ExtendedData>
        <Data name="Governorate">
          <value>Gharbia</value>
        </Data>
        <Data name="Estimated LST (Summer Avg)">
          <value>38.9 °C</value>
        </Data>
        <Data name="UHI Intensity (Delta T)">
          <value>+3.1 °C</value>
        </Data>
        <Data name="Carbon Footprint (kTon CO2e/yr)">
          <value>6,100</value>
        </Data>
        <Data name="Monte Carlo Confidence Interval">
          <value>95% [38.0, 39.8]</value>
        </Data>
        <Data name="Primary Industries">
          <value>Textiles (Misr Spinning &amp; Weaving), Agriculture</value>
        </Data>
        <Data name="Population">
          <value>535,278 (2012)</value>
        </Data>
        <Data name="Area">
          <value>~50 km²</value>
        </Data>
      </ExtendedData>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              31.1300,30.9400,0
              31.2000,30.9400,0
              31.2000,31.0000,0
              31.1300,31.0000,0
              31.1300,30.9400,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

  </Document>
</kml>